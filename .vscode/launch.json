{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RemoteLab Extension: Debug",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/extension/dist/**/*.js"
            ],
            "preLaunchTask": "remotelab:build-extension"
        }
    ]
}