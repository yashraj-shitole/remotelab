{
  "name": "remotelab-vscode",
  "displayName": "RemoteLab",
  "description": "Control VS Code, terminals, tasks, diagnostics, git, and Copilot CLI sessions from RemoteLab.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:remotelab.connectRelay",
    "onCommand:remotelab.disconnectRelay",
    "onCommand:remotelab.showPairingCode",
    "onCommand:remotelab.createManagedTerminal",
    "onCommand:remotelab.continueCopilotCli"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remotelab.connectRelay",
        "title": "RemoteLab: Connect Cloud Relay"
      },
      {
        "command": "remotelab.disconnectRelay",
        "title": "RemoteLab: Disconnect Cloud Relay"
      },
      {
        "command": "remotelab.showPairingCode",
        "title": "RemoteLab: Show Pairing Code"
      },
      {
        "command": "remotelab.createManagedTerminal",
        "title": "RemoteLab: Create Managed Terminal"
      },
      {
        "command": "remotelab.continueCopilotCli",
        "title": "RemoteLab: Continue Copilot CLI Session"
      }
    ],
    "configuration": {
      "title": "RemoteLab",
      "properties": {
        "remotelab.relayUrl": {
          "type": "string",
          "default": "wss://remotelab-relay.onrender.com/relay",
          "description": "Cloud relay WebSocket URL. Use wss:// in production."
        },
        "remotelab.relaySecret": {
          "type": "string",
          "default": "",
          "description": "Optional relay admission secret. Treat as sensitive."
        },
        "remotelab.pairingCode": {
          "type": "string",
          "default": "",
          "description": "Pairing code shared with the mobile app. If empty, the extension generates one per session."
        },
        "remotelab.deviceName": {
          "type": "string",
          "default": "RemoteLab Workstation",
          "description": "Name displayed to the mobile app."
        },
        "remotelab.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Connect to the relay when VS Code starts."
        },
        "remotelab.copilotCliPath": {
          "type": "string",
          "default": "copilot",
          "description": "Command used to launch GitHub Copilot CLI."
        },
        "remotelab.terminalShell": {
          "type": "string",
          "default": "",
          "description": "Shell used for managed terminals. Empty uses the platform default."
        },
        "remotelab.terminalShellArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments passed to the managed terminal shell."
        },
        "remotelab.commandAllowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "workbench.action.files.save",
            "workbench.action.quickOpen",
            "workbench.action.showCommands",
            "workbench.action.problems.focus",
            "workbench.action.terminal.new",
            "workbench.action.tasks.runTask",
            "git.openChange"
          ],
          "description": "VS Code command IDs the mobile app may invoke. Use * only on trusted personal setups."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@remotelab/shared": "file:../shared",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.117.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0"
  }
}
